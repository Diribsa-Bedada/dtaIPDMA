\name{dtaIPDMA-package}
\alias{dtaIPDMA}
\alias{dtaIPDMA-package}
\title{Robust Statistical Methods for Individual Participant Data Meta-Analysis of Diagnostic Test Accuracy}
\description{
Provides robust statistical methods for individual participant data
meta-analysis of diagnostic test accuracy. The initial release implements
classical and precision-weighted Henze-Zirkler tests for empirical Bayes
bivariate study effects.
}
